---
import { Image } from 'astro:assets';
import type { Foto } from '../../content/site';

type Variante = 'topo' | 'equipamento';

interface Props {
  foto: Foto;
  variante: Variante;
}

const { foto, variante } = Astro.props;

const resolucoes: Record<Variante, { widths: number[]; sizes: string }> = {
  topo: {
    widths: [360, 680, 1000, 1360],
    sizes: '(min-width: 1052px) 340px, (min-width: 768px) calc(100vw - 144px), calc(100vw - 88px)',
  },
  equipamento: {
    widths: [208, 320, 640],
    sizes: '(min-width: 768px) 300px, 104px',
  },
};
---

<div class:list={['foto', `foto--${variante}`, foto.imagem ? 'foto--imagem' : 'foto--ilustracao']}>
  {
    foto.imagem ? (
      <Image
        src={foto.imagem}
        alt={foto.alt}
        widths={resolucoes[variante].widths}
        sizes={resolucoes[variante].sizes}
        priority={variante === 'topo'}
      />
    ) : (
      <img
        src={foto.ilustracao.src}
        width={foto.ilustracao.width}
        height={foto.ilustracao.height}
        alt=""
        loading={variante === 'topo' ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
</div>

<style>
  .foto {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }

  .foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foto--ilustracao :global(img) {
    object-fit: contain;
  }

  .foto--topo {
    background: var(--cor-azul);
  }

  .foto--topo.foto--ilustracao :global(img) {
    padding: 12px;
  }

  .foto--equipamento {
    background: var(--cor-foto-pendente);
  }

  .foto--equipamento.foto--ilustracao :global(img) {
    padding: 12px 10px;
  }

  @media (min-width: 768px) {
    .foto--topo.foto--ilustracao :global(img) {
      padding: 32px;
    }

    .foto--equipamento.foto--ilustracao :global(img) {
      padding: 20px;
    }
  }
</style>
