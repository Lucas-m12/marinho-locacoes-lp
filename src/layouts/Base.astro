---
import '../styles/tokens.css';
import '../styles/base.css';
import { acessibilidade, contato, empresa, seo } from '../content/site';

const urlSite = new URL('/', Astro.site);
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlImagemSocial = new URL('/og.png', Astro.site);
const urlFontes = 'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap';

const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: empresa.nome,
  telephone: contato.telefoneInternacional,
  url: urlSite.href,
  areaServed: empresa.municipiosAtendidos.map((municipio) => ({
    '@type': 'City',
    name: municipio,
    containedInPlace: { '@type': 'State', name: empresa.estado },
  })),
  sameAs: [contato.instagram.url],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.titulo}</title>
    <meta name="description" content={seo.descricao} />
    <link rel="canonical" href={urlCanonica.href} />
    <meta name="theme-color" content="#13294B" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={urlFontes} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={empresa.nome} />
    <meta property="og:title" content={seo.titulo} />
    <meta property="og:description" content={seo.descricao} />
    <meta property="og:url" content={urlCanonica.href} />
    <meta property="og:image" content={urlImagemSocial.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imagemAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">{acessibilidade.pularParaConteudo}</a>
    <slot />
    <link rel="stylesheet" href={urlFontes} />
  </body>
</html>
