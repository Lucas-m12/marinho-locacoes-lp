---
import Botao from './ui/Botao.astro';
import Faixa from './ui/Faixa.astro';
import Foto from './ui/Foto.astro';
import Icon from './ui/Icon.astro';
import { topo } from '../content/site';
---

<section id="topo" class="topo fundo-escuro" aria-labelledby="topo-titulo">
  <div class="topo__conteudo container">
    <div class="topo__texto">
      <p class="topo__local">
        <Icon name="local" size={16} />
        {topo.local}
      </p>
      <h1 id="topo-titulo" class="topo__titulo">{topo.titulo}</h1>
      <p class="topo__descricao">{topo.texto}</p>
      <div class="topo__acoes">
        <Botao tamanho="grande">{topo.botao}</Botao>
        <a class="topo__link" href={topo.linkSecundario.href}>{topo.linkSecundario.rotulo}</a>
      </div>
    </div>
    <div class="topo__foto">
      <Foto foto={topo.foto} variante="topo" />
    </div>
  </div>
  <Faixa variante="topo" />
</section>

<style>
  .topo {
    background: var(--cor-azul);
    color: var(--cor-creme);
  }

  .topo__conteudo {
    padding-block: 36px 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .topo__texto {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .topo__local {
    display: flex;
    align-items: center;
    gap: 8px;
    font-stretch: var(--largura-titulo);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cor-terracota-claro);
  }

  .topo__titulo {
    font-stretch: var(--largura-titulo);
    font-weight: 800;
    font-size: 58px;
    line-height: 0.92;
  }

  .topo__descricao {
    font-size: 17px;
    line-height: 1.55;
    color: var(--cor-texto-apoio-no-azul);
  }

  .topo__acoes {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .topo__link {
    align-self: center;
    min-height: var(--alvo-toque);
    display: flex;
    align-items: center;
    font-size: 16px;
    font-weight: 600;
    color: var(--cor-creme);
    text-underline-offset: 5px;
  }

  .topo__link:hover {
    color: var(--cor-terracota-claro);
  }

  .topo__foto {
    height: 240px;
    padding: 24px;
    display: flex;
    background: var(--cor-azul) url('../assets/marca/marinho-grade.svg') 0 0 / 56px 56px;
  }

  @media (min-width: 768px) {
    .topo__conteudo {
      padding-block: 72px 96px;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: stretch;
      gap: 48px;
    }

    .topo__texto {
      flex: 999 1 520px;
      justify-content: center;
      gap: 28px;
    }

    .topo__local {
      gap: 10px;
      font-size: 18px;
      letter-spacing: 0.18em;
    }

    .topo__local :global(.icone) {
      width: 20px;
      height: 20px;
    }

    .topo__titulo {
      font-size: clamp(56px, 7vw, 108px);
      text-wrap: balance;
    }

    .topo__descricao {
      max-width: 560px;
      font-size: 20px;
    }

    .topo__acoes {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 28px;
      padding-top: 8px;
    }

    .topo__link {
      align-self: auto;
      font-size: 18px;
    }

    .topo__foto {
      flex: 1 1 420px;
      min-width: 0;
      height: auto;
      min-height: 440px;
      padding: 40px;
      background-size: 96px 96px;
    }
  }
</style>
